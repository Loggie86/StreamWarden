NODE_ENV=development
HOST=0.0.0.0
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
DASHBOARD_PATH=/
DASHBOARD_DIR=./apps/dashboard/dist
STREAMWARDEN_DB_PATH=./data/streamwarden.sqlite
MAIL_PROVIDER=console
EXPOSE_DEV_MAGIC_LINKS=1

# Required when MAIL_PROVIDER=resend
# RESEND_API_KEY=re_...
# AUTH_FROM_EMAIL=StreamWarden <login@example.com>

# Required for live movie and series search
# TVDB_API_KEY=...
# TVDB_PIN=...
# TVDB_API_BASE_URL=https://api4.thetvdb.com/v4
