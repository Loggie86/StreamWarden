{
  "name": "nuvio-guardian",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test packages/policy-engine/test/*.test.ts apps/addon/test/*.test.ts",
    "test:watch": "node --experimental-strip-types --test --watch packages/policy-engine/test/*.test.ts",
    "dashboard:build": "node scripts/build-dashboard.mjs",
    "dashboard:dev": "npm run dashboard:build && node scripts/serve-dashboard.mjs",
    "addon:start": "node --experimental-strip-types apps/addon/src/server.ts"
  }
}
